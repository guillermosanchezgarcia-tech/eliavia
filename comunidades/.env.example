# Copia este archivo como .env.local y rellena los valores de tu proyecto de Supabase
# (Supabase → Project Settings → API Keys / Data API / Database).

# URL del proyecto (Project URL), p. ej. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública: "anon public" (o "Publishable key")
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave secreta: "service_role" (o "Secret key"). ¡NUNCA la compartas ni la subas a GitHub!
SUPABASE_SERVICE_ROLE_KEY=

# Cadena de conexión a la base de datos (Connect → Session pooler), con tu contraseña en lugar de [YOUR-PASSWORD]
# Solo se usa para crear las tablas y cargar los datos de ejemplo.
DATABASE_URL=

# Fase 2: lectura automática de facturas con la API de Claude (déjalo vacío para desactivarla)
ANTHROPIC_API_KEY=
