# Copia este archivo como «.env.local» y rellena los valores de tu proyecto.
# Están en Supabase → Project Settings → API Keys / Data API.
#
# La «publishable key» (empieza por sb_publishable_…) está pensada para ir
# dentro de la app y es segura: los datos los protegen las reglas de seguridad
# de la base de datos. NUNCA pongas aquí la «secret key» ni la «service_role».

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Nombre de la OP tal y como quieres que aparezca en la app.
VITE_NOMBRE_OP=AGRO NATURE SAT
